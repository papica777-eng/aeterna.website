# 🌌 AETERNA-OMNICORE SOVEREIGN EXCLUSION GITIGNORE
# Enforces strict GDPR, SaMD EU MDR, and Academic IP confidentiality policies
# Whitelists only the frontend presentation layers, schemas, and grant descriptions

# 1. Ignore everything by default
*

# 2. Allow directories to be scanned
!*/

# 3. Whitelist public root files
!.gitignore
!README.md
!index.html
!SovereignHUD.html
!package.json
!package-lock.json
!tsconfig.json
!CNAME
!LICENSE
!ui/SovereignHUD.html



# 4. Whitelist public assets, documents, and configuration directories
!assets/**
!docs/**
!.vscode/**

# 5. Strict blacklists inside whitelisted directories (safety overrides)
**/*.exe
**/*.pdb
**/*.bin
**/*.log
**/*.csv
**/*.xlsx
**/node_modules/
**/target/
**/.shadow.*
**/tmp/
**/.gemini/
**/*.pyc
**/__pycache__/
**/.env
**/.DS_Store
Thumbs.db

# 6. SOVEREIGN BACKEND KERNELS — TRADE SECRET (Directive 2016/943/EU)
# These MUST NEVER leave the local bare-metal vault (Pomorie HQ).
# Even `git add -f` cannot override rules in this section if properly enforced.
**/*.mojo
**/*.soul
BRUTAL_MODULES/
OmniCore/
*.rs
*.zig

# Whitelist public contracts & actions workflows
!.github/workflows/mainnet-deploy.yml
!contracts/**
!contracts/**/*.rs

# Blacklist compiler target directories inside contracts
contracts/**/target/
